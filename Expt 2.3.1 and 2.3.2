class Solution {
public:
    int addDigits(int num) {
        if (num == 0) {
        return 0;
       }
        return 1 + (num - 1) % 9;
    }
};


EXPERIMENT 2.3.2
CODE:
class Solution {
public:
    int findDuplicate(vector<int>& nums) {
        int slow = nums[0];
        int fast = nums[0];
          do {
           slow = nums[slow];
           fast = nums[nums[fast]];
          } while (slow != fast);
            slow = nums[0];
            while (slow != fast) {
              slow = nums[slow];
              fast = nums[fast];
         }
         return slow;
    }
};
